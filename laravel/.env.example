APP_NAME=VaultLine
APP_ENV=local
APP_KEY=base64:XG81mZ9+392B9v1VbN8K5yq1p5k8Z1r7M0v9L4w2A1o=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Frontend origin for strict CORS locking
FRONTEND_URL=http://localhost:3000

# Database Configuration (SQLite default for local development, MySQL in Docker)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vaultline
# DB_USERNAME=vaultline
# DB_PASSWORD=secret_db_password_vaultline_99

SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Rate Limiting & Admin Access
VAULTLINE_ADMIN_TOKEN=vaultline-admin-demo-token
RATE_LIMIT_CREATE_PER_MINUTE=20
RATE_LIMIT_REVEAL_PER_MINUTE=30
RATE_LIMIT_FAILED_PER_MINUTE=5
